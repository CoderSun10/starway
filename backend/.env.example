# 复制为 .env 后填写。.env 已被 gitignore，不会上传。
# 本机用 node 跑 API、连接 Docker 映射出的 MySQL 时使用。

PORT=3001
HOST=0.0.0.0
DB_HOST=127.0.0.1
DB_PORT=3310
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=focusplan

# 若用 docker compose 启动 api 服务，上面 DB_* 会被 compose 覆盖：
# DB_HOST=mysql  DB_PORT=3306  DB_PASSWORD=$MYSQL_ROOT_PASSWORD

JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_smtp_authorization_code
EMAIL_FROM_NAME=星程 Starway
AUTH_DEV_ECHO_CODE=
