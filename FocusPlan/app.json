{
  "expo": {
    "name": "凝时",
    "slug": "ningshi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050403"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ningshi.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDisplayName": "凝时"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050403"
      },
      "package": "com.ningshi.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#D4A84B"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://127.0.0.1:3001"
    }
  }
}
