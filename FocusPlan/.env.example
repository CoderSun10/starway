# 复制为 .env 后填写。.env 已被 gitignore，不会上传。

# ----- Docker Compose / MySQL -----
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=focusplan
MYSQL_PASSWORD=changeme
MYSQL_CONTAINER=ningshi_mysql
API_CONTAINER=ningshi_api

# ----- 移动端默认 API（Expo）-----
# 本机调试用 127.0.0.1；真机改为电脑局域网 IP；云端填你的 API 地址
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# ----- EAS 构建（可选，仅本机/CI 使用）-----
# EAS_PROJECT_ID=
# EAS_OWNER=

# ----- 部署脚本（可选）-----
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_PASS=
# DEPLOY_REMOTE_DIR=/opt/ningshi
# DEPLOY_STAGE=/home/YOUR_USER/ningshi-stage
