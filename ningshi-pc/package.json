{
  "name": "ningshi-pc",
  "version": "1.0.0",
  "description": "凝时 · 专注计划 桌面端 (Windows / Linux)",
  "homepage": "https://github.com/CoderSun10/ningshi",
  "main": "electron/main.cjs",
  "author": "Ningshi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "dev": "node scripts/kill-dev-electron.js && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --force",
    "build:web": "vite build",
    "preview": "vite preview",
    "fix:electron": "node scripts/ensure-electron.js",
    "dist": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:win": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:win:nsis": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis",
    "dist:linux": "vite build && electron-builder --linux deb",
    "dist:all": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --linux deb"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ningshi.pc",
    "productName": "凝时",
    "copyright": "Copyright © Ningshi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Ningshi-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "凝时",
      "artifactName": "Ningshi-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Ningshi <ningshi@local>",
      "artifactName": "ningshi_${version}_${arch}.${ext}"
    }
  }
}
