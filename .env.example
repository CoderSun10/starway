# 复制为 .env 后填写。.env 已被 gitignore，不会上传。
# docker compose 在仓库根目录读取本文件。

# ----- Docker Compose / MySQL -----
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=focusplan
MYSQL_PASSWORD=changeme
MYSQL_CONTAINER=starway_mysql
MYSQL_HOST_PORT=3310
API_CONTAINER=starway_api

# ----- 登录注册 / 邮件验证码（QQ 邮箱 SMTP，与 EduFlow 相同） -----
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_smtp_authorization_code
EMAIL_FROM_NAME=星程 Starway
# 仅本地调试：邮件未配置时在接口里回显验证码。生产环境不要开。
AUTH_DEV_ECHO_CODE=
